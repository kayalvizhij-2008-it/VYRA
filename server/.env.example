# VYRA server configuration. Copy to server/.env — never commit that file.
# Provider keys are read only on the server and never sent to the browser.

# Browser Use gateway (model + optional cloud browser). Billed to your account.
BROWSER_USE_API_KEY=

# Direct model providers. At least one provider is required to run tasks.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Any OpenAI-compatible chat server (Ollama, vLLM, another gateway).
VYRA_OPENAI_BASE_URL=
VYRA_OPENAI_API_KEY=
VYRA_COMPATIBLE_MODEL=local-model

# Optional model defaults (editable per run in Advanced options).
VYRA_OPENAI_MODEL=gpt-6-luna
VYRA_ANTHROPIC_MODEL=claude-sonnet-4-5
VYRA_GOOGLE_MODEL=gemini-2.5-flash

# Deployment: comma-separated browser origins allowed to call the API.
# Example: VYRA_CORS_ORIGINS=https://vyra.vercel.app
VYRA_CORS_ORIGINS=
# Optional regex, e.g. https://vyra-.*\.vercel\.app for preview deployments.
VYRA_CORS_ORIGIN_REGEX=

# Server defaults.
VYRA_MAX_ACTIVE_RUNS=2
VYRA_DEFAULT_MAX_STEPS=60
VYRA_DEFAULT_TIMEOUT_S=600
VYRA_DEFAULT_HEADLESS=true
# Persistent data directory (Render: /data, backed by a disk).
# VYRA_DATA_DIR=./data
